@page
@model ErrorModel
@{
    ViewData["Title"] = "Erro";
}

<div class="page-center">
    <div class="card error-card">
        <h1>Algo deu errado</h1>
        <p>Não foi possível carregar esta página. Tente de novo em alguns instantes.</p>

        @if (Model.ShowRequestId)
        {
            <p>Código do erro: <code>@Model.RequestId</code></p>
        }

        <p><a asp-page="/Index">Voltar para o início</a></p>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/holiday.css" asp-append-version="true" />
}
