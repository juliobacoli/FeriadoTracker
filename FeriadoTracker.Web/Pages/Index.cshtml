@page
@using FeriadoTracker.Web.Services

@model FeriadoTracker.Web.Pages.IndexModel

<div class="page-wrapper page-center">
    <div class="holiday-wrapper" data-initial-date="@(Model.ProximoFeriado is null ? "" : PtBrFormat.Iso(Model.ProximoFeriado.Data))">
        <div class="holiday-card card">
            <div class="holiday-header">
                <div class="holiday-subtitle">PRÓXIMO FERIADO NACIONAL</div>
                <h1 class="holiday-title">@Model.ProximoFeriado?.Nome</h1>

                @if (Model.ProximoFeriado is not null)
                {
                    <p class="holiday-date">
                        @PtBrFormat.DataPorExtenso(Model.ProximoFeriado.Data)
                    </p>
                }
                else
                {
                    <p class="holiday-date">Nenhum feriado encontrado.</p>
                }
            </div>

            <div class="countdown-grid metric-grid">
                <div class="countdown-box metric-box">
                    <div id="days" class="countdown-number metric-number">--</div>
                    <div class="countdown-label metric-label">Dias</div>
                </div>
                <div class="countdown-box metric-box">
                    <div id="hours" class="countdown-number metric-number">--</div>
                    <div class="countdown-label metric-label">Horas</div>
                </div>
                <div class="countdown-box metric-box">
                    <div id="minutes" class="countdown-number metric-number">--</div>
                    <div class="countdown-label metric-label">Minutos</div>
                </div>
                <div class="countdown-box metric-box">
                    <div id="seconds" class="countdown-number metric-number">--</div>
                    <div class="countdown-label metric-label">Segundos</div>
                </div>
            </div>
            
            <div class="share-wrapper">
                <button id="btnShare" class="btn-share" hidden aria-label="Compartilhar feriado">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="18" cy="5" r="3"></circle>
                        <circle cx="6" cy="12" r="3"></circle>
                        <circle cx="18" cy="19" r="3"></circle>
                        <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                        <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                    </svg>
                    Compartilhar
                </button>
            </div>
        </div>

        @if (Model.ProximosFeriados is not null && Model.ProximosFeriados.Any())
        {
            <div class="holiday-timeline-wrapper card">
                <h2 class="holiday-timeline-title">Linha do tempo dos próximos feriados</h2>

                <div class="holiday-timeline">
                    @foreach (var feriado in Model.ProximosFeriados)
                    {
                        var isNext = Model.ProximoFeriado is not null
                        && feriado.Id == Model.ProximoFeriado.Id;

                        <div class="holiday-timeline-item @(isNext ? "is-next is-selected" : "")"
                             data-target-date="@PtBrFormat.Iso(feriado.Data)"
                             data-target-name="@feriado.Nome"
                             data-target-formatted="@PtBrFormat.DataPorExtenso(feriado.Data)">
                            <div class="holiday-timeline-dot"></div>

                            <div class="holiday-timeline-content">
                                <span class="holiday-timeline-date">
                                    @PtBrFormat.DataCurta(feriado.Data) - @PtBrFormat.DiaDaSemana(feriado.Data)
                                </span>
                                <span class="holiday-timeline-name">
                                    @feriado.Nome
                                </span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="creator-card">
            <a href="https://juliobacoli.com.br/" target="_blank" rel="noopener noreferrer" class="creator-link">
                <svg class="site-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#0A66C2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <path d="M2 12h20" />
                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                </svg>
                <span>Desenvolvido por <b>Julio Bacoli</b></span>
            </a>
        </div>

    </div>
</div>


@section Styles {
    <link rel="stylesheet" href="~/css/holiday.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/confetti-lib.js" nonce="@HttpContext.Items["csp-nonce"]" asp-append-version="true"></script>
    <script type="module" src="~/js/main.js" nonce="@HttpContext.Items["csp-nonce"]" asp-append-version="true"></script>
}

