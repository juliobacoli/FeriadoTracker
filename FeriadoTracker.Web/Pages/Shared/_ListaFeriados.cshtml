@using FeriadoTracker.Web.Services
@model FeriadoTracker.Web.Pages.IndexModel
@*
    Lista de feriados dos locais marcados. Vem junto com a página e também sozinha
    (/?handler=Lista&local=...), para as pílulas trocarem a lista sem recarregar.
    Os data-* do contêiner dizem ao destaque qual é a próxima folga desta lista.
*@
<div id="lista" data-proxima="@Model.IndiceDestaque" data-kicker="@Model.KickerProxima">
    @if (Model.Feriados.Count > 0)
    {
        <section aria-labelledby="listTitle">
            <h2 class="list-title" id="listTitle">@Model.TituloLista</h2>
            <p class="list-sub">@Model.PeriodoLista</p>
            @foreach (var ano in Model.Feriados.Select((f, i) => (f, i)).GroupBy(x => x.f.Ano))
            {
                <h3 class="year">@ano.Key</h3>
                <ul class="rows">
                    @foreach (var (f, i) in ano)
                    {
                        var classe = f.Tipo == TipoFolga.FimDeSemana ? "row is-weekend"
                            : f.FolgaLonga ? "row is-long"
                            : "row";

                        <li>
                            @* Os data-* levam ao destaque tudo o que ele mostra deste feriado. *@
                            <button type="button" class="@classe" aria-pressed="@(i == Model.IndiceDestaque ? "true" : "false")"
                                    data-indice="@i"
                                    data-nome="@f.Nome"
                                    data-tipo="@f.Tipo"
                                    data-inicio-iso="@f.InicioIso"
                                    data-fim-iso="@f.FimIso"
                                    data-folga-fim-iso="@f.FolgaFimIso"
                                    data-data-texto="@f.DataTexto"
                                    data-impacto="@f.Impacto"
                                    data-nota-no-dia="@f.NotaNoDia"
                                    data-tem-ponte="@(f.TemPonte ? "true" : "false")">
                                <span class="row-date"><span class="row-day">@f.DiaLista</span><span class="row-mon">@f.MesLista</span></span>
                                <span><span class="row-name">@f.Nome</span><span class="row-info">@f.ImpactoCurto</span></span>
                                @if (Model.Locais.Count > 0)
                                {
                                    <span class="selo @(f.Regional ? "is-regional" : "")">@f.Selo</span>
                                }
                            </button>
                            <template id="faixa-@i"><partial name="_Faixa" model="f" /></template>
                        </li>
                    }
                </ul>
            }
        </section>
    }
</div>
