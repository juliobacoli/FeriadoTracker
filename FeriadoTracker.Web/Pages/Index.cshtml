@page
@using FeriadoTracker.Web.Services
@model FeriadoTracker.Web.Pages.IndexModel

<div class="page">
    @if (Model.Destaque is { } d)
    {
        <section class="focus" id="destaque" aria-labelledby="focusName" data-proxima="@Model.IndiceDestaque">
            <p class="kicker" id="focusKicker">Sua próxima folga</p>
            <h1 class="name" id="focusName" tabindex="-1">@d.Nome</h1>
            <p class="date" id="focusDate">@d.DataTexto</p>

            <div class="count" id="focusCount">
                <span class="count-part"><span class="count-num">@Model.DiasAteDestaque</span><span class="count-unit">@(Model.DiasAteDestaque == 1 ? "dia" : "dias")</span></span>
            </div>
            <p class="exact" id="focusExact" aria-hidden="true"></p>
            <p class="today-note" id="focusNote" hidden></p>

            <figure class="strip">
                <ol class="strip-days" id="focusStrip" aria-label="Dias em volta do feriado">
                    @foreach (var dia in d.Faixa)
                    {
                        <li class="@dia.Classe" data-iso="@dia.Iso" aria-label="@dia.Rotulo"><span class="wd" aria-hidden="true">@dia.DiaSemana</span><span class="dn" aria-hidden="true">@dia.Dia</span></li>
                    }
                </ol>
                <figcaption>
                    <p class="impact @(d.Tipo == TipoFolga.Prolongado ? "is-long" : "")" id="focusImpact">@d.Impacto</p>
                    <ul class="legend">
                        <li><span class="sw sw-off" aria-hidden="true"></span>Folga</li>
                        <li id="legendPonte" hidden="@(!d.TemPonte)"><span class="sw sw-ponte" aria-hidden="true"></span>Ponte possível</li>
                    </ul>
                </figcaption>
            </figure>

            <div class="actions">
                <button class="btn btn-main" id="btnLembrete" type="button" aria-pressed="false">
                    <svg class="icon-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                    <svg class="icon-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                    <span data-rotulo-off="Me avisar dos feriados" data-rotulo-on="Lembretes ativos">Me avisar dos feriados</span>
                </button>
                <button class="btn" id="btnShare" type="button" hidden>
                    <svg class="icon-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4"/></svg>
                    <svg class="icon-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                    <span>Compartilhar</span>
                </button>
            </div>

            <p class="back" id="focusBack" hidden><button type="button">Voltar para a próxima folga</button></p>
        </section>
    }
    else
    {
        <section class="focus">
            <h1 class="name">Nenhum feriado encontrado.</h1>
        </section>
    }

    @if (Model.Feriados.Count > 0)
    {
        <section aria-labelledby="listTitle">
            <h2 class="list-title" id="listTitle">Próximos feriados</h2>
            @foreach (var ano in Model.Feriados.Select((f, i) => (f, i)).GroupBy(x => x.f.Ano))
            {
                <h3 class="year">@ano.Key</h3>
                <ul class="rows">
                    @foreach (var (f, i) in ano)
                    {
                        var classe = f.Tipo == TipoFolga.FimDeSemana ? "is-weekend" : "is-off";
                        if (f.Tipo == TipoFolga.Prolongado) classe += " is-long";

                        <li>
                            <button type="button" class="row @classe" data-indice="@i" aria-pressed="@(i == Model.IndiceDestaque ? "true" : "false")">
                                <span class="row-date"><span class="row-day">@f.DiaLista</span><span class="row-mon">@f.MesLista</span></span>
                                <span><span class="row-name">@f.Nome</span><span class="row-info">@f.ImpactoCurto</span></span>
                            </button>
                        </li>
                    }
                </ul>
            }
        </section>

        <script type="application/json" id="feriadosDados">@Html.Raw(Model.FeriadosJson)</script>
    }
</div>

@section Scripts {
    <script type="module" src="~/js/main.js" nonce="@HttpContext.Items["csp-nonce"]" asp-append-version="true"></script>
}
